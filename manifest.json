{
  "manifest_version": 3,
  "name": "Vocab Tracker",
  "version": "0.1.0",
  "description": "Automatically collects words you look up on Google (\"<word> meaning\", \"define <word>\", ...) and turns them into flashcards.",
  "homepage_url": "https://github.com/s-4-m-a-n/auto-flash-card-creator",
  "minimum_chrome_version": "117",
  "permissions": ["webNavigation", "storage"],
  "host_permissions": ["https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Vocab Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
